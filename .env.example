# Pajisto Landingpage V2 – Environment-Vorlage. KEINE Geheimnisse in diese Datei
# oder ins Repository schreiben. Echte Werte nur im Hosting (z. B. Vercel →
# Settings → Environment Variables) oder lokal in .env.local hinterlegen.

# ── Lead-Einsendung ─────────────────────────────────────────────────────────
# mock  = ausdrücklicher Vorschau-Modus: nichts wird versendet, die Seite zeigt das an
# close = Einsendung an Close CRM (benötigt CLOSE_API_KEY)
# leer  = lokal (next dev) "mock"; in Produktion ist das Formular deaktiviert
LEAD_MODE=mock

# Close API-Key (Settings → Developer → API Keys). Nur serverseitig, niemals
# mit NEXT_PUBLIC_-Präfix.
CLOSE_API_KEY=

# Optional: Lead-Status für neue Leads (z. B. ID von "Inbound Lead Ads",
# siehe docs/CLOSE_INTEGRATION.md). Leer = Standardstatus des Kontos.
CLOSE_LEAD_STATUS_ID=

# Optional: IDs der Lead-Custom-Fields (Format cf_...). Leere Felder werden
# nicht geschrieben; der Kontext steht dann nur in der Lead-Beschreibung.
CLOSE_CF_FREQUENCY_CHOICE=
CLOSE_CF_SOURCE=
CLOSE_CF_SEGMENT=
CLOSE_CF_FREQUENCY=
CLOSE_CF_AMOUNT=
CLOSE_CF_DEBTOR_TYPE=
CLOSE_CF_STAGE=
CLOSE_CF_CONTACT_PREFERENCE=
CLOSE_CF_LANDING_VARIANT=
CLOSE_CF_FUNNEL_VARIANT=
CLOSE_CF_UTM_SOURCE=
CLOSE_CF_UTM_CAMPAIGN=

# ── Öffentliche Konfiguration (landet im Browser-Bundle) ────────────────────
# Kennung dieser Seite für die Attribution (C = Multistep-Anfrage).
NEXT_PUBLIC_LANDING_VARIANT=C

# A/B-Test der Funnel-Länge: kurz | ausfuehrlich | split (50/50 je Aufruf).
# Per URL erzwingbar: ?fv=kurz bzw. ?fv=ausfuehrlich
NEXT_PUBLIC_FUNNEL_VARIANT=kurz

# Optionaler Terminlink in der Bestätigungsansicht (https). Leer = kein Link.
NEXT_PUBLIC_BOOKING_URL=

# Tracking: leer = vollständig deaktiviert, es erscheint kein Consent-Banner.
# Mit ID: Laden erst NACH Einwilligung.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Ziel-Domain (ohne Slash am Ende). Erst setzen, wenn die Domain feststeht;
# steuert Canonical und Open Graph.
NEXT_PUBLIC_SITE_URL=

# Nur auf der finalen Produktiv-Domain auf "true" setzen. Sonst noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# "true" blendet die Vorschau-Kennzeichnung auch im Produktions-Build ein
# (für Testdeployments). In next dev ist sie immer sichtbar.
NEXT_PUBLIC_SHOW_PREVIEW_BAR=false
